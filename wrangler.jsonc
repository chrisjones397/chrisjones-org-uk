// How Cloudflare publishes this site. Two Workers build from this one repository:
//   chrisjones397-github-io      builds main, deploy command: npx wrangler deploy
//   chrisjones397-github-io-dev  builds dev,  deploy command: npx wrangler deploy --env dev
// The dev Worker MUST use --env dev: without it, it would deploy under the live Worker's name.
// Most of the site is served straight from the files. worker.js runs first only for the pages filled in from
// the content database (the home page, painting addresses, the list), uploaded images and the editor.
//
// Each Worker has its own content database and editor address:
//   live: database site-content,     site chrisjones.org.uk,     editor admin.chrisjones.org.uk
//   dev:  database site-content-dev, site dev.chrisjones.org.uk, editor admin-dev.chrisjones.org.uk
// The editor addresses are guarded by Cloudflare Access applications "Site editor" and "Site editor (dev)";
// ACCESS_AUD is the application's audience tag, which editor.js checks. Not secret.
{
  "name": "chrisjones397-github-io",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,                  // no copy of the site at *.workers.dev
  "preview_urls": false,                 // nor a preview address for every version
  "observability": { "enabled": true },  // keep the Worker's logs
  "assets": {
    "directory": ".",                    // the site is the repository itself (less .assetsignore)
    "binding": "ASSETS",                 // how worker.js reaches the files
    "not_found_handling": "404-page",    // unknown addresses get 404.html, not a blank page
    "run_worker_first": ["/", "/index.html", "/paintings/*", "/gallery/list", "/gallery/list/*", "/media/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "site-content", "database_id": "92160592-99ad-48c8-84db-e418928d0f46" }
  ],
  "vars": {
    "ACCESS_TEAM": "still-mountain-1dde",
    "ACCESS_AUD": "ca39b2c971b595c36e1479cb521c66718da1fe939ea614b90a1fcc85ed6c1ef2"
  },
  "env": {
    "dev": {
      "name": "chrisjones397-github-io-dev",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/", "/index.html", "/paintings/*", "/gallery/list", "/gallery/list/*", "/media/*", "/admin", "/admin/*"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "site-content-dev", "database_id": "746fef4b-4f14-402a-b658-3ef2a1576dbb" }
      ],
      "vars": {
        "ACCESS_TEAM": "still-mountain-1dde",
        "ACCESS_AUD": "3b28d37f6295867b106354e6e8a4d4d00ffd9e21dce71b311daf8a9b87e3e362"
      }
    }
  }
}
