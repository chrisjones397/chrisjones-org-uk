// How Cloudflare publishes this site. Two Workers build from this one repository:
//   chrisjones-org-uk      builds main, deploy command: npx wrangler deploy
//   chrisjones-org-uk-dev  builds dev,  deploy command: npx wrangler deploy --env dev
// The dev Worker MUST use --env dev: without it, it would deploy under the live Worker's name.
// The content database's tables are made and changed by the numbered files in migrations/ (the default folder for
// `wrangler d1 migrations apply DB`); .assetsignore keeps them off the site.
// Nothing is built: the repository is the site. Most of it is served straight from the files. worker.js runs
// first only for the pages filled in from the content database (the home page, the gallery page, painting
// addresses), uploaded images and the editor; and, where no file matches, for "page not found".
//
// Each Worker has its own content database and editor address:
//   live: database site-content,     images site-media,     site chrisjones.org.uk,     editor admin.chrisjones.org.uk
//   dev:  database site-content-dev, images site-media-dev, site dev.chrisjones.org.uk, editor admin-dev.chrisjones.org.uk
// The editor addresses are guarded by Cloudflare Access applications "Site editor" and "Site editor (dev)";
// ACCESS_AUD is the application's audience tag, which editor.js checks. Not secret.
{
  "name": "chrisjones-org-uk",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,                  // no copy of the site at *.workers.dev
  "preview_urls": false,                 // nor a preview address for every version
  "observability": { "enabled": true },  // keep the Worker's logs
  "assets": {
    "directory": ".",                    // the site is the repository itself (less .assetsignore)
    "binding": "ASSETS",                 // how worker.js reaches the files
    "not_found_handling": "none",        // an address with no file goes to worker.js (404.html with the header)
    "run_worker_first": ["/", "/index.html", "/gallery", "/gallery/*", "/media/*", "/edit", "/edit/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "site-content", "database_id": "92160592-99ad-48c8-84db-e418928d0f46" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "site-media" }       // the Library's files (served at /media/<code>/...)
  ],
  "vars": {
    "ACCESS_TEAM": "chrisjones-org-uk",
    "ZONE_ID": "de7244c21e7d293994f4b6a18014fb3f",   // chrisjones.org.uk: for purging cached files (library.js; secret PURGE_TOKEN)
    "ACCESS_AUD": "ca39b2c971b595c36e1479cb521c66718da1fe939ea614b90a1fcc85ed6c1ef2"
  },
  "env": {
    "dev": {
      "name": "chrisjones-org-uk-dev",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": ["/", "/index.html", "/gallery", "/gallery/*", "/media/*", "/edit", "/edit/*"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "site-content-dev", "database_id": "746fef4b-4f14-402a-b658-3ef2a1576dbb" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "site-media-dev" }
      ],
      "vars": {
        "ACCESS_TEAM": "chrisjones-org-uk",
        "ZONE_ID": "de7244c21e7d293994f4b6a18014fb3f",
        "ACCESS_AUD": "3b28d37f6295867b106354e6e8a4d4d00ffd9e21dce71b311daf8a9b87e3e362"
      }
    }
  }
}
